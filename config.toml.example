[bot]
token = "YOUR_BOT_TOKEN_HERE"
guild_id = 000000000000000000
prefix = "YOUR_PREFIX_HERE "

[autorole]
enabled = true
member_role_id = 000000000000000000
bot_role_id = 000000000000000000

[welcome]
# Available placeholders for messages:
# {member_mention} -> Mentions the member who joined (e.g., @Username)
# {member_name}    -> Plain text username of the member
# {member_id}      -> Discord ID of the member
# {guild_name}     -> Name of the Discord server
# {guild_count}    -> Total member count after joining
enabled = true
channel_id = 000000000000000000
embed_color = "#000000"
message_title = "YOUR_WELCOME_TITLE_HERE"
message_description = "YOUR_WELCOME_DESCRIPTION_HERE"

[leave]
# Available placeholders for messages:
# {member_mention} -> Mentions the member who left (e.g., @Username)
# {member_name}    -> Plain text username of the member
# {member_id}      -> Discord ID of the member
# {guild_name}     -> Name of the Discord server
# {guild_count}    -> Total member count after leaving
enabled = true
channel_id = 000000000000000000
embed_color = "#000000"
message = "YOUR_LEAVE_MESSAGE_HERE"
